{
  "name": "pumpkin-contest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "setup-firebase": "ts-node --project tsconfig.script.json scripts/setup-test-data.ts",
    "create-sample-data": "ts-node --project tsconfig.script.json scripts/create-2024-sample-data.ts",
    "fix-placeholder-urls": "ts-node --project tsconfig.script.json scripts/fix-placeholder-urls.ts",
    "clean": "rm -rf .next",
    "refresh": "npm run clean && npm run build && npm run dev"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^4.2.0",
    "firebase": "^10.12.0",
    "next": "14.2.x",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@netlify/functions": "^2.6.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.0",
    "dotenv": "^16.6.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.x",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
