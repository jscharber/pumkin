rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is admin
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == request.resource.data.adminEmail;
    }

    // Contests: public read, admin write
    match /contests/{contestId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Categories: public read, admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Entries: public read, public create (during submission window), admin update/delete
    match /entries/{entryId} {
      allow read: if true;
      allow create: if true;  // Submission window enforced in app
      allow update: if request.auth != null;  // Only authenticated admins can update
      allow delete: if request.auth != null;
    }

    // Entry contact info: anyone can add it with their entry, only admins can read it
    match /entryContacts/{entryId} {
      allow create: if request.resource.data.contactInfo is string
                    && request.resource.data.contactInfo.size() <= 500;
      allow read, update, delete: if request.auth != null;
    }

    // Votes: public read, public create (one per visitor/category), no update/delete
    match /votes/{voteId} {
      allow read: if true;
      allow create: if true;  // Duplicate prevention in app
      allow update, delete: if false;
    }
  }
}