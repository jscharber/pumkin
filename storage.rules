rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /entries/{contestId}/{fileName} {
      // Anyone can read images
      allow read: if true;

      // Anyone can upload images (with restrictions)
      allow write: if request.resource.size < 10 * 1024 * 1024  // 10MB max
                   && request.resource.contentType.matches('image/.*');
    }

    match /contests/{contestId}/{fileName} {
      // Anyone can read contest images (e.g. Home page header)
      allow read: if true;

      // Only authenticated admins can upload or delete
      allow delete: if request.auth != null;
      allow create, update: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // 10MB max
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
